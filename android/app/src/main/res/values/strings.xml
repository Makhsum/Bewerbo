    <string name="settings_account_switch_body">Enter the key shown on the other device. This device then works on that account; nothing is deleted from the account you leave.</string>
    <string name="settings_account_switch_confirm">Continue</string>

    <string name="settings_language">Language of the app</string>
    <string name="settings_language_hint">The language everything you read here is written in. The language you write your PROFILE in belongs to the profile, so it is set there.</string>

    <string name="settings_data">What is held about you</string>
    <string name="settings_data_hint">A Lebenslauf is personal data, and the law gives you three things because of it: to see what is held, to take a copy with you, and to have it deleted. All three are here.</string>
    <string name="settings_data_export">Save a copy</string>
    <string name="settings_data_export_hint">Written into the documents of the app as one file, exactly as the server holds it.</string>
    <string name="settings_data_delete">Delete the account and everything in it</string>
    <string name="settings_delete_title">Delete everything?</string>
    <string name="settings_delete_body">What you entered about yourself, the documents on file, the postings you pasted and every application are deleted from the server. This cannot be undone. Bewerbo then opens an empty account, so you can begin again.</string>

    <!-- What is held, by category. Counted rather than described: a zero is an answer to the
         question too, and a category left out reads as one being withheld. -->
